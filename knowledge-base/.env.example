# Use hexadecimal values so the password is safe inside DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_32_RANDOM_HEX_CHARACTERS
MCP_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
KB_PORT=3000
MODEL_REVISION=5617a9f
EMBEDDING_THREADS=4
MAX_REQUEST_BYTES=16777216
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
CONSOLIDATION_TOP_K=5
# Passed to Pi via models.json; never commit real credentials.
KB_LLM_API_KEY=REPLACE_WITH_YOUR_PROVIDER_API_KEY

# Active strategies without external search exposure expire independently of correctness.
KB_INACTIVITY_ENABLED=true
KB_INACTIVITY_DAYS=90
# Optional external search MCP configuration for paper verification (private, never commit).
# PAPER_SEARCH_MCP_CONFIG=/app/config/search-mcp.json
# Default per-connection/tool timeout. Increase up to 120000 for first uvx/npx startup.
PAPER_MCP_TIMEOUT_MS=20000
# Optional signed Debian package mirror used only while building the app image.
DEBIAN_MIRROR=http://deb.debian.org
